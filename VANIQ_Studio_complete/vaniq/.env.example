# Copy to .env and edit. Never commit .env.
# "live" (real recordings, real STT) or "demo" (synthetic data, labelled placeholder STT; no credentials needed)
VANIQ_MODE=live

# Gnani Prisma / Vachana STT credentials (leave empty to run without STT)
GNANI_API_KEY=your-api-key-here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MODEL=prisma-v3.0
GNANI_TIMEOUT_S=30
GNANI_MAX_RETRIES=2

# Server
VANIQ_HOST=127.0.0.1
VANIQ_PORT=8000
VANIQ_LOG_LEVEL=INFO

# Data directory (live and demo data are kept in separate subfolders: <dir>/live and <dir>/demo)
VANIQ_DATA_DIR=./data

# Upload limits and segmentation
VANIQ_MAX_UPLOAD_MB=50
VANIQ_MAX_AUDIO_SECONDS=600
VANIQ_SEG_ENERGY_THRESHOLD=50
VANIQ_SEG_MAX_DUR_S=15
